              {
                "name": "count",
                "value": "",
                "type": "query",
                "description": "The number of results displayed on one page."
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "The page number for listing the results"
              }
            ]
          },
          "docs": "Return the list of epochs preceding a specific epoch."
        },
        {
          "info": {
            "name": "Blockfrost Stake Distribution",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://cardano-mainnet.blockfrost.io/api/v0/epochs/:number/stakes",
            "params": [
