              },
              {
                "name": "pool_id",
                "value": "pool1pu5jlj4q9w9jlxeu370a3c9myx47md5j5m2str0naunn2q3lkdy",
                "type": "path",
                "description": "Stake pool ID to filter"
              },
              {
                "name": "count",
                "value": "",
                "type": "query",
                "description": "The number of results displayed on one page."
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "The page number for listing the results."
              }
            ]
          },
          "docs": "Return the active stake distribution for the epoch specified by stake pool."
        },
        {
